# Server-only model-provider credentials. Gemini is used when it is configured
# and the study's preferred provider is unavailable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini-2026-03-17

# Supabase project settings. Never expose the service-role key to browser code.
SUPABASE_URL=https://wxmxnahytjrlailgjxvq.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# development, pilot, or main. Main requires a frozen active config.
IDEON_STUDY_PHASE=development

# Development only. Never enable in a participant study build.
NEXT_PUBLIC_IDEON_DEBUG_INSPECTOR=false
